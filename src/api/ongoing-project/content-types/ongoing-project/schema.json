{
  "kind": "collectionType",
  "collectionName": "ongoing_projects",
  "info": {
    "singularName": "ongoing-project",
    "pluralName": "ongoing-projects",
    "displayName": "Ongoing Project"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "timeline": {
      "type": "string"
    },
    "projectStatus": {
      "type": "customField",
      "customField": "global::move-to-completed",
      "default": "Ongoing"
    },
    "scope": {
      "type": "text"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "cx": {
      "type": "decimal"
    },
    "cy": {
      "type": "decimal"
    }
  }
}