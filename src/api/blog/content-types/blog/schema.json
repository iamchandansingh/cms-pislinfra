{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog",
    "description": "Blog posts with advanced SEO tracking"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "content": {
      "type": "richtext"
    },
    "category": {
      "type": "string"
    },
    "publishDate": {
      "type": "date"
    },
    "readTime": {
      "type": "string"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "galleryImages": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "tags": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "statusField": {
      "type": "string"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "focusKeyword": {
      "type": "string"
    },
    "seoScore": {
      "type": "integer",
      "min": 0,
      "max": 100
    },
    "faqSchema": {
      "type": "text"
    }
  }
}
