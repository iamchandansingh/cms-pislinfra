{
  "kind": "collectionType",
  "collectionName": "solution_pages",
  "info": {
    "singularName": "solution-page",
    "pluralName": "solution-pages",
    "displayName": "Solution Page",
    "description": "Pages for solutions like Industrial, Infrastructure, etc."
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "title": { "type": "string", "required": true },
    "heroSubtitle": { "type": "string" },
    "breadcrumb": { "type": "string" },
    "heroImage": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    
    "introText": { "type": "richtext" },
    
    "mainFeatureTitle": { "type": "string" },
    "mainFeatureText": { "type": "richtext" },
    "mainFeatureImage": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    
    "whyPislBadge": { "type": "string" },
    "whyPislTitle": { "type": "string" },
    "whyPislDesc": { "type": "text" },
    "whyPislImage": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    
    "features": { "type": "component", "repeatable": true, "component": "shared.feature-card" },
    "grids": { "type": "component", "repeatable": true, "component": "shared.solution-grid" },
    
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
