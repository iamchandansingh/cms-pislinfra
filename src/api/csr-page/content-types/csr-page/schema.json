    "philosophyTitle": { "type": "string" },
    "philosophyDescription": { "type": "text" },
    "philosophyImages": { "type": "media", "multiple": true, "required": false, "allowedTypes": ["images"] },
    "focusAreas": { "type": "component", "repeatable": true, "component": "csr.focus-area" },
    "givingBackCards": { "type": "component", "repeatable": true, "component": "csr.card" },
    "environmentCards": { "type": "component", "repeatable": true, "component": "csr.card" },
    "celebrationCards": { "type": "component", "repeatable": true, "component": "csr.card" }
