{
  "kind": "singleType",
  "collectionName": "blog_pages",
  "info": {
    "singularName": "blog-page",
    "pluralName": "blog-pages",
    "displayName": "Blog Page",
    "description": "Main landing page for Blogs"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "heroTitle": {
      "type": "string",
      "required": true,
      "default": "Blog"
    },
    "heroSubtitle": {
      "type": "string",
      "required": true,
      "default": "Insights, news & updates from PISL INFRA"
    },
    "heroBreadcrumb": {
      "type": "string",
      "required": true,
      "default": "Blog"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "primaryKeyword": {
      "type": "string",
      "maxLength": 120
    },
    "metaTitle": {
      "type": "string",
      "maxLength": 100
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 320
    },
    "focusKeywords": {
      "type": "text",
      "maxLength": 500
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
